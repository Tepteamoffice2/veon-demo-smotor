---
import FutureLink from "./FutureLink.astro";
import { serviceGroups, stations, telegram, money } from "../data/smotor";
---
<section id="poslugy" class="band band--paper services" aria-labelledby="poslugy-title" data-rec="U-R003,U-R004">
  <div class="container">
    <div class="services__head">
      <h2 id="poslugy-title">Послуги та ціни</h2>
      <p class="services__lead">Ціни від: точну вартість назвемо після діагностики.</p>
    </div>

    <div class="services__switch" data-tabs>
      <div class="services__tabs" data-tablist aria-label="Групи послуг">
        {serviceGroups.map((g, i) => (
          <button class="services__tab" type="button" id={`tab-${g.id}`} data-tab={g.id} aria-selected={i === 0 ? "true" : "false"}>{g.title}</button>
        ))}
        <span class="services__indicator" aria-hidden="true"></span>
      </div>

      <div class="services__cols">
        {serviceGroups.map((g, i) => (
          <div class="services__group" id={`group-${g.id}`} data-panel={g.id} data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <h3 class="services__group-title">{g.title}</h3>
            <ul class="price-list">
              {g.items.map((s) => (
                <li class="price-row">
                  <span class="price-row__name">{s.name}</span>
                  {s.price !== null
                    ? <span class="price-row__price"><span class="price-row__from">від</span> <span class="num">{money(s.price)}</span> <span class="price-row__unit">грн</span></span>
                    : <span class="price-row__ask">ціну назве майстер</span>}
                  <a class="price-row__cta link link--brand" href="#kontakty">Записатися<span class="visually-hidden">: {s.name.toLowerCase()}</span></a>
                </li>
              ))}
            </ul>
            {g.note && (
              <div class="services__hint">
                <p>{g.note}</p>
                <p class="services__hint-links">
                  <a class="link link--brand" href={stations[0].viber} data-event="viber" data-station="kyiv">Viber Київ</a>
                  <a class="link link--brand" href={stations[1].viber} data-event="viber" data-station="vyshneve">Viber Вишневе</a>
                  <a class="link link--brand" href={telegram} target="_blank" rel="noopener" data-event="telegram">Telegram</a>
                </p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <p class="services__more"><FutureLink align="start">Усі 17 послуг з описом</FutureLink></p>
  </div>
</section>

<style>
  .services__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .services__lead { color: var(--color-muted); max-width: 44ch; }

  .services__tabs { display: none; }
  :global(.js) .services__tabs { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--color-rule); margin-bottom: var(--space-lg); }
  .services__tab { min-height: 3rem; padding: 0 var(--space-xs); border: 0; background: none; color: var(--color-muted); font: 600 var(--text-md)/1.1 var(--font-body); cursor: pointer; transition: color var(--dur-short) var(--ease-out); -webkit-tap-highlight-color: transparent; }
  .services__tab:hover { color: var(--color-ink); }
  .services__tab[aria-selected="true"] { color: var(--color-brand); }
  .services__indicator { position: absolute; left: 0; bottom: -1px; width: calc(100% / 3); height: 3px; background: var(--color-brand); transform: translateX(calc(var(--tab-index, 0) * 100%)); transition: transform var(--dur-short) var(--ease-in-out); }

  .services__cols { display: grid; gap: var(--space-2xl); }
  .services__group[hidden] { display: none; }
  .services__group.is-entering { animation: panel-in var(--dur-short) var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; } }
  .services__group-title { font-size: var(--text-lead); padding-bottom: var(--space-sm); border-bottom: 3px solid var(--color-ink); }
  :global(.js) .services__group-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .price-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name price" "cta price"; column-gap: var(--space-md); row-gap: 0; align-items: center; padding-top: var(--space-md); padding-bottom: var(--space-2xs); border-bottom: 1px solid var(--color-rule); }
  .price-row__name { grid-area: name; font-weight: 600; line-height: 1.3; }
  .price-row__price, .price-row__ask { grid-area: price; text-align: right; }
  .price-row__price { color: var(--color-brand); white-space: nowrap; }
  .price-row__price .num { font: 800 var(--text-lead)/1 var(--font-display); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .price-row__from, .price-row__unit { font-size: var(--text-sm); }
  .price-row__ask { font-size: var(--text-sm); color: var(--color-muted); max-width: 9rem; line-height: 1.3; }
  .price-row__cta { grid-area: cta; justify-self: start; display: inline-flex; align-items: center; min-height: 2.75rem; font-size: var(--text-sm); white-space: nowrap; }

  .services__hint { display: grid; gap: var(--space-xs); margin-top: var(--space-lg); padding: var(--space-md) var(--space-lg); background: var(--color-surface); border-radius: var(--radius); font-size: var(--text-sm); }
  .services__hint-links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
  .services__hint-links .link { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: var(--text-md); }

  .services__more { margin-top: var(--space-xl); color: var(--color-muted); }

  @media (min-width: 48rem) {
    .price-row__price .num { font-size: 1.75rem; }
  }
  @media (min-width: 64rem) {
    .services__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); align-items: end; margin-bottom: var(--space-2xl); }
    .services__head h2 { grid-column: 1 / span 6; text-wrap: balance; }
    .services__lead { grid-column: 8 / span 5; }
    :global(.js) .services__tabs { display: none; }
    .services__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-xl); align-items: start; }
    .services__group[hidden] { display: block; }
    :global(.js) .services__group-title { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .services__indicator { transition: none; }
    .services__group.is-entering { animation: none; }
  }
</style>
